# Generates a C++ source that embeds every file of the Web UI and the Vault
# template. Usage: cmake -DOUT=<file> -DUI_DIR=<dir> -DVAULT_DIR=<dir> -DSKILLS_DIR=<dir> -DLOADER_DIR=<dir> -P embed.cmake
set(content "#include \"embedded.hpp\"\nnamespace pc2 {\n")
set(table "")
set(i 0)

foreach(group IN ITEMS ui vault skills loader)
  if(group STREQUAL "ui")
    set(dir "${UI_DIR}")
  elseif(group STREQUAL "vault")
    set(dir "${VAULT_DIR}")
  elseif(group STREQUAL "skills")
    set(dir "${SKILLS_DIR}")
  else()
    set(dir "${LOADER_DIR}")
  endif()
  file(GLOB_RECURSE files RELATIVE "${dir}" "${dir}/*")
  list(SORT files)
  foreach(f IN LISTS files)
    file(READ "${dir}/${f}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND content "static const unsigned char d${i}[] = {${bytes}0};\n")
    string(APPEND table "  {\"${group}\", \"${f}\", d${i}, sizeof(d${i}) - 1},\n")
    math(EXPR i "${i}+1")
  endforeach()
endforeach()

string(APPEND content "const EmbeddedFile kEmbedded[] = {\n${table}};\n")
string(APPEND content "const size_t kEmbeddedCount = sizeof(kEmbedded) / sizeof(kEmbedded[0]);\n}\n")
file(WRITE "${OUT}" "${content}")
